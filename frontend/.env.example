# ==========================================
# Urban Spice Frontend Environment Variables
# ==========================================

# Production: Point to your Render Django backend URL, e.g. https://urban-spice-backend.onrender.com/api
# Local Dev: http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Razorpay Test Mode Public Key ID (Required for Razorpay Checkout popup in browser)
# Strictly Test Mode key starting with rzp_test_
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
