# ==========================================
# Urban Spice Backend Environment Variables
# ==========================================

# Set to False in production (Render), True for local development
DEBUG=True

# Long random secret key for cryptographic signing
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-32-chars-minimum

# PostgreSQL connection string
# Local: postgresql://localhost:5432/urban_spice
# Render: Render Internal Database URL (or External Database URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/urban_spice

# Allowed Hosts (comma-separated). Render automatically appends RENDER_EXTERNAL_HOSTNAME.
# Production example: urban-spice-backend.onrender.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin URL for CORS
# Production: https://your-urban-spice.vercel.app
# Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Additional comma-separated CORS allowed origins (e.g. Vercel deployment URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted origins for CSRF in Django 4+ cross-origin POST/PATCH requests
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Test Mode Credentials (MUST start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_me_with_webhook_secret

# Cloudinary Media Storage (from Cloudinary Console Dashboard)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

